# .env
# .env обязательно добавь в .gitignore.

OPENAI_API_KEY=open_ai_api_key
XAI_API_KEY=grok_api_key

# OpenAI-модули, которые генерируются по запросу FastAPI
AI_ON_DEMAND_ENABLED=1
AI_FORCE_REBUILD=1
OPENAI_NORMATIVE_MODEL=gpt-5.4-mini
OPENAI_REVIEW_MODEL=gpt-5.4-mini
OPENAI_PRICE_MODEL=gpt-5.4-mini
OPENAI_MAX_CANDIDATES_PER_TAG=5

# Grok-критик
GROK_CRITIC_ENABLED=1
GROK_CRITIC_EVERY_REQUEST=1
GROK_CRITIC_MODEL=grok-4.3
GROK_CRITIC_REASONING=medium

# Единый веб-интерфейс
BOILER_ELEC_PIPELINE_MODE=real
BOILER_ELEC_RUNS_ROOT=data/output/runs
BOILER_ELEC_PROJECTS_ROOT=data/projects
BOILER_ELEC_NORMS_DIR=data/norms

# Ограничения загрузки и очереди расчётов
BOILER_ELEC_MAX_UPLOAD_MB=80
BOILER_ELEC_MAX_CONCURRENT_RUNS=1

# Публичный адрес веб-интерфейса.
# Указать HTTPS-адрес Tailscale Funnel без завершающего слеша.
BOILER_ELEC_PUBLIC_BASE_URL=https://boiler-ai.example-tailnet.ts.net

# Секрет владельца для создания ссылок-приглашений.
# Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BOILER_ELEC_SHARE_ADMIN_TOKEN=replace_with_long_random_secret

# Demo-режим, используется только для smoke-test или демонстрации
BOILER_ELEC_DEMO_RUNS_ROOT=demo_data/runs
BOILER_ELEC_DEMO_PROJECT=25-05